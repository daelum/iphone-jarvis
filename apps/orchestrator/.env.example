# Required for live Cursor Cloud Agents calls
CURSOR_API_KEY=

# Optional overrides
PORT=8787
CURSOR_API_BASE_URL=https://api.cursor.com
DEFAULT_REPO_URL=https://github.com/daelum/iphone-jarvis
DEFAULT_REPO_REF=main

# Auth stub — any non-empty Bearer token is accepted in Slice 1.
# Replace with Sign in with Apple verification (see src/auth/README.md).
JARVIS_DEV_TOKEN=dev-token

# Approval stub channel: "console" logs tickets; "in_memory" only.
APPROVAL_CHANNEL=console

# Ephemeral vault TTL (seconds)
VAULT_TTL_SECONDS=600
